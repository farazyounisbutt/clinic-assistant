# Non-secret example values only. No integration credentials are needed.
CLINIC_ID=demo_clinic
DOCTOR_NAME=Demo Doctor
SPECIALTY=Specialist
CLINIC_TIMEZONE=Asia/Karachi
APPOINTMENT_DURATION_MINUTES=20
BOOKING_HORIZON_DAYS=30
SAME_DAY_BOOKING_ALLOWED=true
SUBSCRIPTION_STATUS=active

# Optional Google Sheets adapter inputs. Replace only in ignored local secret files.
# For Wrangler dev use .dev.vars; for a deployed Worker use Cloudflare secrets.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# JSON object mapping clinic IDs to spreadsheet IDs. No real targets in this file.
GOOGLE_SHEETS_TARGETS=

# Optional WhatsApp Cloud API adapter. Set secrets only in ignored .dev.vars or
# Cloudflare secrets. Blank mapping means the public webhook fails closed.
META_ACCESS_TOKEN=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# JSON object: {"<WHATSAPP_PHONE_NUMBER_ID>":"demo_clinic"}
WHATSAPP_PHONE_CLINICS=
# Supported application default; override after testing the chosen Meta version.
WHATSAPP_GRAPH_VERSION=v26.0

# Setup-only Meta test asset IDs; never put real IDs in this example.
# Runtime clinic routing continues to use WHATSAPP_PHONE_CLINICS.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
