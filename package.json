{
  "name": "clinic-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp-first clinic appointment and queue management service.",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.9",
    "@cloudflare/workers-types": "5.20260914.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.2"
  }
}
